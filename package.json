{
  "name": "easy-code-agent",
  "version": "0.1.0",
  "description": "EASY CODE - a local CLI coding agent for Qwen and DeepSeek",
  "type": "module",
  "bin": {
    "easy-code": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "npm-shrinkwrap.json",
    "README.md",
    "PLAN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build:test && node scripts/run-tests.cjs",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.cjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=16.20.0"
  },
  "keywords": [
    "coding-agent",
    "cli",
    "qwen",
    "deepseek"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "chalk": "5.6.2",
    "commander": "11.1.0",
    "env-paths": "3.0.0",
    "execa": "8.0.1",
    "node-sqlite3-wasm": "0.8.60",
    "toml": "3.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "typescript": "^5.4.5"
  }
}
