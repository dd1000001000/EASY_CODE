{
  "name": "easy-code-agent",
  "version": "0.1.0",
  "description": "EASY CODE - a local CLI coding agent with a user-maintained OpenAI-compatible model registry",
  "type": "module",
  "bin": {
    "easy-code": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "benchmarks/__init__.py",
    "benchmarks/swebench_verified/__init__.py",
    "benchmarks/swebench_verified/easy_code_agent.py",
    "benchmarks/swebench_verified/split_environment.py",
    "benchmarks/swebench_verified/sandbox-resources.json",
    "benchmarks/swebench_verified/README.md",
    "benchmarks/swebench_verified/run.ps1",
    "benchmarks/swebench_verified/subset-50.json",
    "benchmarks/swebench_verified/verify_manifest.py",
    "resources/prompt-bundle",
    "resources/models.default.toml",
    "scripts/embedding-model.cjs",
    "scripts/postinstall.cjs",
    "scripts/install-vscode-extension.cjs",
    "scripts/verify-vscode-extension.cjs",
    "vscode-extension/easy-code-vscode.manifest.json",
    "vscode-extension/easy-code-vscode.vsix",
    "docs",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "bundle:build": "node scripts/build-prompt-bundle.cjs",
    "clean:build": "node scripts/clean-build.cjs dist",
    "clean:build:test": "node scripts/clean-build.cjs dist-test",
    "build": "npm run bundle:build && npm run clean:build && tsc -p tsconfig.json && npm run build:web",
    "build:web": "vue-tsc -p src/web/tsconfig.json --noEmit && vite build --config src/web/vite.config.ts",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build:test && node scripts/run-tests.cjs && npm run test:vscode",
    "test:vscode": "npm --prefix vscode-extension test",
    "test:native-sandbox": "npm run build && node scripts/smoke-native-sandbox.mjs",
    "build:test": "npm run bundle:build && npm run clean:build:test && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p src/web/tsconfig.json --noEmit",
    "install:doctor": "node dist/index.js install doctor",
    "postinstall": "node scripts/postinstall.cjs",
    "memory:install": "node scripts/embedding-model.cjs prepare",
    "memory:verify": "node scripts/embedding-model.cjs verify",
    "vscode:install": "node scripts/install-vscode-extension.cjs",
    "package:vscode": "npm --prefix vscode-extension ci --ignore-scripts --include=dev && npm --prefix vscode-extension run package && node scripts/verify-vscode-extension.cjs --write",
    "prepack": "npm run build && node scripts/verify-vscode-extension.cjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "coding-agent",
    "cli",
    "qwen",
    "deepseek",
    "kimi",
    "moonshot-ai",
    "glm",
    "zhipu"
  ],
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@huggingface/tokenizers": "0.1.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "2.1.0",
    "@openai/codex": "0.153.4",
    "@orama/orama": "2.1.1",
    "chalk": "5.6.2",
    "commander": "11.1.0",
    "diff": "5.2.2",
    "element-plus": "2.11.1",
    "env-paths": "3.0.0",
    "execa": "8.0.1",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "node-sqlite3-wasm": "0.8.60",
    "onnxruntime-node": "1.16.3",
    "toml": "5.0.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/diff": "5.2.3",
    "@types/node": "20.19.43",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "^5.4.5",
    "vite": "6.4.3",
    "vue": "3.5.43",
    "vue-tsc": "2.2.12"
  }
}
